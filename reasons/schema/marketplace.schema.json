{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "featured": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Names of the Reasons in the Featured row, in order."
    },
    "reasons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.\\/[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Reason folders, in listing order."
    }
  },
  "required": [
    "name",
    "displayName",
    "owner",
    "featured",
    "reasons"
  ],
  "additionalProperties": false,
  "description": "The Reasons a Reason marketplace lists."
}
