{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable kebab-case id, equal to the folder name. Never renamed or reused."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "What the Reason is called once added."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220,
      "description": "The marketplace card line: what it does and what it works from."
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engineering",
          "sales",
          "marketing",
          "design",
          "personal",
          "recruiting-people",
          "product",
          "operations"
        ]
      },
      "description": "Where it is listed; the first is its own category."
    },
    "appearance": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "enum": [
            "black",
            "blue",
            "orange",
            "green",
            "purple",
            "red",
            "teal",
            "pink",
            "amber",
            "brown",
            "grey",
            "white"
          ]
        },
        "eyes": {
          "type": "string",
          "enum": [
            "pills",
            "dots",
            "small",
            "wide",
            "sleepy",
            "brows"
          ]
        },
        "glasses": {
          "type": "string",
          "enum": [
            "none",
            "round",
            "square_shades",
            "aviators",
            "round_shades",
            "monocle",
            "magnifier"
          ]
        },
        "accessory": {
          "type": "string",
          "enum": [
            "none",
            "headphones",
            "bow_tie",
            "beret",
            "bowler",
            "cap",
            "antenna",
            "crown",
            "party_hat",
            "top_hat"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "hexagon",
            "round",
            "blob",
            "square",
            "star",
            "flower",
            "pebble",
            "pentagon",
            "diamond",
            "octagon",
            "shield",
            "cloud",
            "ticket"
          ]
        }
      },
      "required": [
        "color",
        "eyes",
        "glasses",
        "accessory"
      ],
      "additionalProperties": false,
      "description": "Its bot face; the Reason hexagon unless shape says otherwise."
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Plugin slugs from reason-machines/reason-marketplace; whoever adds the Reason signs in to each."
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Folder names under skills/, in order; the first is Getting started."
    }
  },
  "required": [
    "name",
    "displayName",
    "description",
    "categories",
    "appearance",
    "plugins",
    "skills"
  ],
  "additionalProperties": false,
  "description": "A Reason: a ready-made agent for the Reason marketplace (https://reasonmachines.com)."
}
